{
  "name": "hearatlas-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "node scripts/build-demo.mjs",
    "preview": "vite preview",
    "test": "node scripts/check-parity.mjs && node --test scripts/logic.test.mjs scripts/audio.test.mjs scripts/features.test.mjs scripts/erb.test.mjs scripts/archive.test.mjs scripts/advanced.test.mjs scripts/healthkit.test.mjs scripts/medical.test.mjs",
    "assets": "capacitor-assets generate --ios --android --assetPath ../mobile/resources --iconBackgroundColor '#6E826B' --iconBackgroundColorDark '#4B5E48' --splashBackgroundColor '#EFF5EC' --splashBackgroundColorDark '#232B22'",
    "build:mobile": "node scripts/mobile.mjs build",
    "cap:sync": "node scripts/mobile.mjs sync",
    "cap:sync:android": "node scripts/mobile.mjs sync android",
    "cap:sync:ios": "node scripts/mobile.mjs sync ios",
    "android": "node scripts/mobile.mjs open android",
    "ios": "node scripts/mobile.mjs open ios",
    "android:run": "node scripts/mobile.mjs run android",
    "ios:run": "node scripts/mobile.mjs run ios",
    "android:debug": "node scripts/mobile.mjs debug android",
    "ios:debug": "node scripts/mobile.mjs debug ios",
    "android:test": "node scripts/mobile.mjs test android",
    "test:mobile": "node --test scripts/mobile.test.mjs scripts/native.test.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "vite": "6.4.6"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "HearAtlas — nền tảng giáo dục và nghiên cứu thính giác, web/PWA/mobile (product alpha)",
  "license": "MIT"
}

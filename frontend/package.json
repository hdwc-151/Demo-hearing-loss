{
  "name": "dr-bunny-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "node scripts/build-demo.mjs",
    "preview": "vite preview",
    "test": "node scripts/check-parity.mjs && node --test scripts/logic.test.mjs scripts/audio.test.mjs scripts/features.test.mjs scripts/erb.test.mjs scripts/archive.test.mjs",
    "assets": "capacitor-assets generate --ios --android --assetPath ../mobile/resources --iconBackgroundColor '#6E826B' --iconBackgroundColorDark '#4B5E48' --splashBackgroundColor '#EFF5EC' --splashBackgroundColorDark '#232B22'",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.17",
    "vite": "5.4.21"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Dr. Bunny — mô phỏng trải nghiệm nghe kém (web, PWA, iOS, Android)",
  "license": "MIT"
}

# Sao chép thành .env (không commit). Chỉ cần khi chạy backend ngoài mặc định.
# CORS: danh sách origin được phép, cách nhau bằng dấu phẩy
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LLM tuỳ chọn (API tương thích OpenAI). Không có khoá thì Bác sĩ Thỏ dùng câu trả lời tầng 1 (không cần mạng).
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_TIMEOUT=15
# Chỉ khi cài torch và có checkpoint WaveGAN
GAN_CKPT=
